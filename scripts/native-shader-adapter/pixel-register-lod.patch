 void ShaderRecompiler::recompile(const TextureFetchInstruction& instr, bool bicubic)
 {
+    const bool registerLodFetch = rawInput && isPixelShader &&
+        instr.opcode == FetchOpcode::TextureFetch && instr.useRegLod;
+    if (rawInput && !isPixelShader && instr.opcode == FetchOpcode::TextureFetch &&
+        instr.useRegLod)
+        throw std::runtime_error("unsupported vertex register LOD");
+    if (rawInput && isPixelShader)
+    {
+        switch (instr.opcode)
+        {
+        case FetchOpcode::SetTextureLod:
+            if (instr.isPredicated)
+                throw std::runtime_error("unsupported pixel register LOD: predicated setter");
+            if (instr.srcRegisterAm)
+                throw std::runtime_error("unsupported pixel register LOD: relative setter");
+
+            indent();
+            println("registerLod = r{}.{};", instr.srcRegister, SWIZZLES[instr.srcSwizzle & 0x3]);
+            rawPixelRegisterLodSet = true;
+            return;
+
+        case FetchOpcode::SetTextureGradientsHorz:
+        case FetchOpcode::SetTextureGradientsVert:
+            throw std::runtime_error("unsupported pixel register LOD: gradients");
+
+        case FetchOpcode::TextureFetch:
+            if (instr.useRegLod)
+            {
+                if (instr.isPredicated)
+                    throw std::runtime_error("unsupported pixel register LOD: predicated fetch");
+                if (instr.srcRegisterAm || instr.dstRegisterAm)
+                    throw std::runtime_error("unsupported pixel register LOD: relative fetch");
+                if (!rawPixelRegisterLodSet)
+                    throw std::runtime_error("pixel register LOD fetch has no preceding setter");
+                if (instr.dimension != TextureDimension::Texture2D &&
+                        instr.dimension != TextureDimension::TextureCube)
+                    throw std::runtime_error("unsupported pixel register LOD: texture dimension");
+                if (instr.texCoordDenorm)
+                    throw std::runtime_error("unsupported pixel register LOD: unnormalized coordinates");
+                if (instr.useCompLod || instr.useRegGradients)
+                    throw std::runtime_error("unsupported pixel register LOD: computed or gradient mode");
+                if (instr.lodBias != 0 || instr.offsetX != 0 ||
+                    instr.offsetY != 0 || instr.offsetZ != 0)
+                    throw std::runtime_error("unsupported pixel register LOD: bias or offset");
+                if (!rawRegisters)
+                    throw std::runtime_error("pixel register LOD fetch has no register snapshot");
+                const uint32_t descriptor = (*rawRegisters)[0x4800 + instr.constIndex * 6 + 4];
+                if (((descriptor >> 12) & 0x3FFu) != 0)
+                    throw std::runtime_error("unsupported pixel register LOD: descriptor bias");
+            }
+            break;
+
+        case FetchOpcode::GetTextureComputedLod:
+        case FetchOpcode::GetTextureGradients:
+            throw std::runtime_error("unsupported pixel register LOD: computed or gradient instruction");
+
+        default:
+            break;
+        }
+    }
+
     if (instr.opcode != FetchOpcode::TextureFetch && instr.opcode != FetchOpcode::GetTextureWeights)
         return;
 
@@ -372,7 +433,11 @@
             out += "1.0 - ";
     #endif
 
-        out += "tfetch";
+        if (registerLodFetch)
+            out += instr.dimension == TextureDimension::TextureCube ?
+                "tfetchCubeRegisterLod" : "tfetch2DRegisterLod";
+        else
+            out += "tfetch";
         break;
     }
     case FetchOpcode::GetTextureWeights:
@@ -405,7 +470,8 @@
         break;
     }
 
