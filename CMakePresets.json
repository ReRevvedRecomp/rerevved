{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "REREVVED_DEVELOPER": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-22",
                "CMAKE_CXX_COMPILER": "clang++-22",
                "REREVVED_DEVELOPER": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "windows-arm64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-march=armv8-a",
                "CMAKE_CXX_FLAGS": "-march=armv8-a"
            }
        },
        {
            "name": "win-amd64-debug",
            "displayName": "Windows AMD64 Debug",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "win-amd64-release",
            "displayName": "Windows AMD64 Release",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "win-amd64-developer",
            "displayName": "Windows AMD64 Developer",
            "description": "Release build with the developer recorders and replay tools; never packaged",
            "inherits": "win-amd64-release",
            "cacheVariables": {
                "REREVVED_DEVELOPER": "ON",
                "BUILD_TESTING": "ON",
                "REREVVED_PREPARED_TESTS": "ON"
            }
        },
        {
            "name": "linux-amd64-debug",
            "displayName": "Linux AMD64 Debug",
            "inherits": "linux-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-amd64-release",
            "displayName": "Linux AMD64 Release",
            "inherits": "linux-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-amd64-developer",
            "displayName": "Linux AMD64 Developer",
            "description": "Release build with the developer recorders; never packaged",
            "inherits": "linux-amd64-release",
            "cacheVariables": {
                "REREVVED_DEVELOPER": "ON",
                "BUILD_TESTING": "ON"
            }
        },
        {
            "name": "win-amd64-relwithdebinfo",
            "displayName": "Windows AMD64 RelWithDebInfo",
            "inherits": "windows-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "linux-amd64-relwithdebinfo",
            "displayName": "Linux AMD64 RelWithDebInfo",
            "inherits": "linux-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "win-arm64-debug",
            "displayName": "Windows ARM64 Debug",
            "inherits": "windows-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "win-arm64-release",
            "displayName": "Windows ARM64 Release",
            "inherits": "windows-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "win-arm64-relwithdebinfo",
            "displayName": "Windows ARM64 RelWithDebInfo",
            "inherits": "windows-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        },
        {
            "name": "linux-arm64-debug",
            "displayName": "Linux ARM64 Debug",
            "inherits": "linux-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
        },
        {
            "name": "linux-arm64-release",
            "displayName": "Linux ARM64 Release",
            "inherits": "linux-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
        },
        {
            "name": "linux-arm64-relwithdebinfo",
            "displayName": "Linux ARM64 RelWithDebInfo",
            "inherits": "linux-arm64-base",
            "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
        }
    ],
    "buildPresets": [
        { "name": "win-amd64-debug", "configurePreset": "win-amd64-debug" },
        { "name": "win-amd64-release", "configurePreset": "win-amd64-release" },
        { "name": "win-amd64-developer", "configurePreset": "win-amd64-developer" },
        { "name": "win-amd64-relwithdebinfo", "configurePreset": "win-amd64-relwithdebinfo" },
        { "name": "linux-amd64-debug", "configurePreset": "linux-amd64-debug" },
        { "name": "linux-amd64-release", "configurePreset": "linux-amd64-release" },
        { "name": "linux-amd64-developer", "configurePreset": "linux-amd64-developer" },
        { "name": "linux-amd64-relwithdebinfo", "configurePreset": "linux-amd64-relwithdebinfo" },
        { "name": "win-arm64-debug", "configurePreset": "win-arm64-debug" },
        { "name": "win-arm64-release", "configurePreset": "win-arm64-release" },
        { "name": "win-arm64-relwithdebinfo", "configurePreset": "win-arm64-relwithdebinfo" },
        { "name": "linux-arm64-debug", "configurePreset": "linux-arm64-debug" },
        { "name": "linux-arm64-release", "configurePreset": "linux-arm64-release" },
        { "name": "linux-arm64-relwithdebinfo", "configurePreset": "linux-arm64-relwithdebinfo" },
        {
            "name": "win-amd64-local-fast",
            "displayName": "Windows AMD64 local-fast tests",
            "configurePreset": "win-amd64-release",
            "targets": ["rerevved_fast_tests"]
        }
    ],
    "testPresets": [
        {
            "name": "win-amd64-developer",
            "displayName": "Windows AMD64 Developer tests",
            "configurePreset": "win-amd64-developer",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "linux-amd64-developer",
            "displayName": "Linux AMD64 Developer tests",
            "configurePreset": "linux-amd64-developer",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "win-amd64-local-fast",
            "displayName": "Windows AMD64 local-fast tests",
            "configurePreset": "win-amd64-release",
            "configuration": "Release",
            "filter": { "include": { "label": "local-fast" } },
            "execution": { "jobs": 2 },
            "output": { "outputOnFailure": true }
        }
    ]
}
